{
  "rules_version": "v1.1-2026-10-15",
  "description": "node_announcement feature bits by release line, per Lightning implementation. Read by shared/lightning/version_fingerprint.py. Final releases only (no rc / master / dev builds). A line is a run of releases whose default node_announcement bits are identical, so gossip cannot tell them apart.",
  "fields": {
    "line": "display label of the release line",
    "first": "first release in the line",
    "last": "last release in the line known when the table was built",
    "released": "publication date of the first release of the line (GitHub release page; crates.io for LDK), YYYY-MM-DD: the day operators could install it. v1 used the tag commit date; v1.1 (2026-10-15) moved 10 lines by 1-12 days, bits unchanged",
    "default": "node_announcement bits with default config (and default plugins: CLN keysend)",
    "optional_add": "bits a non-developer operator can add in this line (options, flags, plugins, known bLIP custom bits)",
    "removable": "default bits a non-developer operator can remove in this line",
    "source": "where the default set comes from (tag:file); full per-bit citations in docs/ln_release_features/<impl>.md"
  },
  "provenance": "Computed from source at every release tag on 2026-10-07 (blobless clones; see docs/ln_release_features/). Not modelled: developer overrides (CLN --dev-force-features, LND runtime updatenodeannouncement in 0.15-0.16), third-party plugins, forks, secondary signals (CLTV / fee / htlc_max defaults).",
